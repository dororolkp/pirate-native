{
  "expo": {
    "name": "Pirate",
    "slug": "pirate-native",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "pirate-native",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dororolkp.pirate",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.dororolkp.pirate",
      "adaptiveIcon": {
        "backgroundColor": "#fff1e7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Pirate | Fleet and Mission Control",
      "description": "Cross-platform fleet and mission control. Safe simulation by default."
    },
    "plugins": ["expo-router", "expo-sharing"],
    "experiments": { "typedRoutes": true }
  }
}
