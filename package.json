{
  "name": "pirate-native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:bundles": "expo export --platform all --output-dir native-export",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "lint": "expo lint",
    "typecheck": "node --stack-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.{json,ts,tsx,md,js}\"",
    "deploy:web": "npx vercel@latest --prod",
    "preview:web": "serve dist -s -l 8081",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "private": true
}
