{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "native-export"]
}
