# Public build-time settings. Never put secrets here.
# David's server base URL, without /api/v1. Empty means safe local simulation.
# Settings can select a session-only URL; configured failures never become demo.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_ROBOT_ID=robot_01
# Optional real GA4 web measurement ID (G-...), consent required.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
# The driving pad remains local-only. David's BACKEND_ADAPTER chooses mock/Gazebo.
